    "ExternalRiskEstimate": {
      "direction": -1,
      "immutable": false,
      "step_fraction": 0.08,
      "step_fraction_source": "declared",
      "justification": "FICO-family risk score: higher = less risky (protective)."
    },
    "MSinceOldestTradeOpen": {
      "direction": -1,
      "immutable": true,
      "step_fraction": null,
      "step_fraction_source": null,
      "justification": "Longer credit history reduces default risk."
    },
    "MSinceMostRecentTradeOpen": {
      "direction": 0,
      "immutable": false,
      "step_fraction": 0.2,
      "step_fraction_source": "default",
      "justification": "Recency of newest account is directionally ambiguous."
    },
    "AverageMInFile": {
      "direction": -1,
      "immutable": true,
      "step_fraction": null,
